# Detect text files and keep platform launch scripts usable after checkout.
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.go text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Embedded fonts, artwork, recordings and Windows resource objects.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.syso binary

# Preserve exact embedded asset and font-license bytes for release verification.
/web/assets/** -text
/build/font-licenses/*.txt -text
# Upstream license texts intentionally retain original whitespace.
/web/assets/ui-fonts/*-OFL.txt -whitespace
/web/assets/fonts/licenses/*.txt -whitespace
/build/font-licenses/*.txt -whitespace
