--- /dev/null
+++ b/client/Windows/wf_dengshell_view.h
@@ -0,0 +1,26 @@
+/* DengShell embedded desktop: aspect-preserving viewport and pointer mapping. */
+#ifndef DENGSHELL_RDP_VIEW_H
+#define DENGSHELL_RDP_VIEW_H
+#include <stdint.h>
+typedef struct { int x, y, width, height; } DengShellView;
+static inline DengShellView dengshell_view(int vw, int vh, int dw, int dh)
+{
+ DengShellView v = {0, 0, 0, 0};
+ if (vw <= 0 || vh <= 0 || dw <= 0 || dh <= 0) return v;
+ if ((int64_t)vw * dh <= (int64_t)vh * dw) {
+  v.width = vw; v.height = (int)((int64_t)vw * dh / dw);
+ } else { v.height = vh; v.width = (int)((int64_t)vh * dw / dh); }
+ if (v.width < 1) v.width = 1;
+ if (v.height < 1) v.height = 1;
+ v.x = (vw-v.width)/2; v.y = (vh-v.height)/2;
+ return v;
+}
+static inline int dengshell_pointer(int coordinate, int offset, int extent, int desktop)
+{
+ if (extent <= 0 || desktop <= 0) return 0;
+ int64_t p = (int64_t)(coordinate-offset) * desktop / extent;
+ if (p < 0) return 0;
+ if (p >= desktop) return desktop-1;
+ return (int)p;
+}
+#endif
